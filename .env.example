# Skopiuj do .env i ustaw adres backendu.
# Emulator Androida: http://10.0.2.2:8080
# Fizyczny telefon w tej samej sieci Wi-Fi: http://<IP komputera>:8080
# Serwer: https://lumogo.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Kalendarz Google (wymaga backendu /api/calendar/*, którego jeszcze nie ma)
EXPO_PUBLIC_CALENDAR_ENABLED=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
